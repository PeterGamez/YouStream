{
  "name": "backend",
  "engines": {
    "bun": "1.4.x"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsup",
    "start": "bun run dist/index.mjs",
    "tsc": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' --config .prettierrc.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.3",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "bun@1.4.2"
}